{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://promptsforparents.org/{{PAGE_PATH}}/#article",
      "headline": "{{ARTICLE_TITLE}}",
      "description": "{{META_DESCRIPTION}}",
      "image": {
        "@type": "ImageObject",
        "url": "https://promptsforparents.org/images/{{FEATURED_IMAGE}}",
        "width": 1200,
        "height": 630
      },
      "datePublished": "{{DATE_PUBLISHED}}",
      "dateModified": "{{DATE_MODIFIED}}",
      "author": {
        "@type": "Person",
        "name": "{{AUTHOR_NAME}}",
        "url": "https://promptsforparents.org/about/#{{AUTHOR_SLUG}}",
        "jobTitle": "{{AUTHOR_TITLE}}",
        "description": "{{AUTHOR_BIO}}"
      },
      "publisher": {
        "@id": "https://promptsforparents.org/#organization"
      },
      "isPartOf": {
        "@id": "https://promptsforparents.org/#website"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://promptsforparents.org/{{PAGE_PATH}}/"
      },
      "articleSection": "{{CATEGORY_NAME}}",
      "keywords": "{{KEYWORDS_CSV}}",
      "wordCount": "{{WORD_COUNT}}",
      "inLanguage": "en-US",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [
          ".article-title",
          ".article-summary",
          ".prompt-text"
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://promptsforparents.org/{{PAGE_PATH}}/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://promptsforparents.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{CATEGORY_NAME}}",
          "item": "https://promptsforparents.org/prompts/{{CATEGORY_SLUG}}/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ARTICLE_TITLE}}",
          "item": "https://promptsforparents.org/{{PAGE_PATH}}/"
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://promptsforparents.org/{{PAGE_PATH}}/#howto",
      "name": "{{HOWTO_TITLE}}",
      "description": "{{HOWTO_DESCRIPTION}}",
      "totalTime": "{{ESTIMATED_TIME}}",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "{{AI_TOOL_NAME}}"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "{{STEP_1_TITLE}}",
          "text": "{{STEP_1_TEXT}}",
          "url": "https://promptsforparents.org/{{PAGE_PATH}}/#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "{{STEP_2_TITLE}}",
          "text": "{{STEP_2_TEXT}}",
          "url": "https://promptsforparents.org/{{PAGE_PATH}}/#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "{{STEP_3_TITLE}}",
          "text": "{{STEP_3_TEXT}}",
          "url": "https://promptsforparents.org/{{PAGE_PATH}}/#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "{{STEP_4_TITLE}}",
          "text": "{{STEP_4_TEXT}}",
          "url": "https://promptsforparents.org/{{PAGE_PATH}}/#step-4"
        }
      ]
    }
  ]
}
