{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{CANONICAL_URL}}#article",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{CANONICAL_URL}}#webpage"
      },
      "headline": "{{ARTICLE_TITLE}}",
      "description": "{{META_DESCRIPTION}}",
      "image": {
        "@type": "ImageObject",
        "url": "{{FEATURED_IMAGE_URL}}",
        "width": "{{FEATURED_IMAGE_WIDTH}}",
        "height": "{{FEATURED_IMAGE_HEIGHT}}"
      },
      "datePublished": "{{DATE_PUBLISHED_ISO}}",
      "dateModified": "{{DATE_MODIFIED_ISO}}",
      "wordCount": "{{WORD_COUNT}}",
      "articleSection": "{{CATEGORY_NAME}}",
      "keywords": "{{COMMA_SEPARATED_TAGS}}",
      "inLanguage": "en-US",
      "author": {
        "@type": "Person",
        "@id": "https://themodernparentzone.com/author/{{AUTHOR_SLUG}}/#person",
        "name": "{{AUTHOR_NAME}}",
        "url": "https://themodernparentzone.com/author/{{AUTHOR_SLUG}}/",
        "description": "{{AUTHOR_BIO}}",
        "image": {
          "@type": "ImageObject",
          "url": "{{AUTHOR_IMAGE_URL}}"
        },
        "sameAs": [
          "{{AUTHOR_INSTAGRAM_URL}}",
          "{{AUTHOR_PINTEREST_URL}}"
        ]
      },
      "publisher": {
        "@id": "https://themodernparentzone.com/#organization"
      },
      "isPartOf": {
        "@id": "https://themodernparentzone.com/#website"
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [
          ".entry-title",
          ".article-intro",
          ".key-takeaways"
        ]
      },
      "potentialAction": [
        {
          "@type": "ReadAction",
          "target": "{{CANONICAL_URL}}"
        },
        {
          "@type": "ShareAction",
          "target": "{{CANONICAL_URL}}"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "{{CANONICAL_URL}}#webpage",
      "url": "{{CANONICAL_URL}}",
      "name": "{{PAGE_TITLE}}",
      "description": "{{META_DESCRIPTION}}",
      "isPartOf": {
        "@id": "https://themodernparentzone.com/#website"
      },
      "inLanguage": "en-US",
      "breadcrumb": {
        "@id": "{{CANONICAL_URL}}#breadcrumb"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "{{FEATURED_IMAGE_URL}}"
      },
      "datePublished": "{{DATE_PUBLISHED_ISO}}",
      "dateModified": "{{DATE_MODIFIED_ISO}}"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{CANONICAL_URL}}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://themodernparentzone.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{CATEGORY_NAME}}",
          "item": "{{CATEGORY_URL}}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ARTICLE_TITLE}}",
          "item": "{{CANONICAL_URL}}"
        }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://themodernparentzone.com/#organization",
      "name": "The Modern Parent Zone",
      "url": "https://themodernparentzone.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://themodernparentzone.com/wp-content/uploads/2023/logo-modern-parent-zone.png",
        "width": 600,
        "height": 60
      },
      "sameAs": [
        "https://www.pinterest.com/themodernparentzone/",
        "https://www.instagram.com/themodernparentzone/"
      ]
    }
  ]
}
